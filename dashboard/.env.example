PORT=3000
MQTT_URL=mqtts://YOUR_EMQX_HOST:8883
MQTT_USERNAME=YOUR_MQTT_USERNAME
MQTT_PASSWORD=YOUR_MQTT_PASSWORD
MQTT_TOPIC=grenvis/sensor/data
MQTT_STATUS_TOPIC=grenvis/sensor/status
MQTT_CONTROL_TOPIC=grenvis/device/control
MQTT_REJECT_UNAUTHORIZED=true
DEMO_MODE=true

# Threshold wajib disesuaikan dengan spesies/media tanaman.
SOIL_DRY=30
SOIL_VERY_DRY=20
SOIL_WET=80
TEMP_HIGH=35
HUMIDITY_LOW=45
HUMIDITY_HIGH=80
CONSECUTIVE_REQUIRED=3

# Cloud TFLite AI Vision Backend (Railway)
AI_VISION_URL=https://web-production-e0039.up.railway.app
